@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
	<TopNav />

	<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
		@Body
	</main>

	<Footer />
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed inset-x-0 bottom-0 hidden bg-red-600 px-4 py-3 text-sm text-white">
	An unhandled error has occurred.
	<a href="." class="underline">Reload</a>
	<span class="cursor-pointer">🗙</span>
</div>
