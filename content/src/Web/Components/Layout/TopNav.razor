@using System.Security.Claims

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
		<div class="flex items-center gap-8">
			<a href="/" class="text-lg font-semibold text-slate-900 dark:text-white">
				BlazorServerTemplate
			</a>

			<div class="hidden items-center gap-6 md:flex">
				<a href="/" class="text-sm font-medium text-slate-600 hover:text-primary-600 dark:text-slate-300 dark:hover:text-primary-400">Home</a>
				<AuthorizeView>
					<Authorized>
						<a href="/profile" class="text-sm font-medium text-slate-600 hover:text-primary-600 dark:text-slate-300 dark:hover:text-primary-400">Profile</a>
					</Authorized>
				</AuthorizeView>
				<AuthorizeView Roles="Admin">
					<Authorized>
						<a href="/admin" class="text-sm font-medium text-slate-600 hover:text-primary-600 dark:text-slate-300 dark:hover:text-primary-400">Admin</a>
					</Authorized>
				</AuthorizeView>
			</div>
		</div>

		<div class="flex items-center gap-3">
			<button
				type="button"
				id="theme-toggle"
				aria-label="Toggle light and dark theme"
				class="rounded-md p-2 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">
				<span aria-hidden="true">🌓</span>
			</button>

			<AuthorizeView>
				<Authorized>
					<span class="hidden text-sm text-slate-600 dark:text-slate-300 sm:inline">
						@context.User.Identity?.Name
					</span>
					<form method="post" action="/logout">
						<AntiforgeryToken />
						<button type="submit" class="rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">
							Log out
						</button>
					</form>
				</Authorized>
				<NotAuthorized>
					<a href="/login" class="rounded-md bg-primary-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-primary-700">
						Log in
					</a>
				</NotAuthorized>
			</AuthorizeView>

			<button
				type="button"
				id="mobile-menu-toggle"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				class="rounded-md p-2 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 md:hidden">
				<span aria-hidden="true">☰</span>
			</button>
		</div>
	</nav>

	<div id="mobile-menu" hidden class="border-t border-slate-200 px-4 py-3 dark:border-slate-800 md:hidden">
		<div class="flex flex-col gap-3">
			<a href="/" class="text-sm font-medium text-slate-600 dark:text-slate-300">Home</a>
			<AuthorizeView>
				<Authorized>
					<a href="/profile" class="text-sm font-medium text-slate-600 dark:text-slate-300">Profile</a>
				</Authorized>
			</AuthorizeView>
			<AuthorizeView Roles="Admin">
				<Authorized>
					<a href="/admin" class="text-sm font-medium text-slate-600 dark:text-slate-300">Admin</a>
				</Authorized>
			</AuthorizeView>
		</div>
	</div>
</header>
